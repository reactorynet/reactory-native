# Reactory Native Environment Configuration
# Copy this file to .env and update with your values

# API Configuration
REACT_APP_API_ENDPOINT=http://localhost:4000
# The CDN endpoint for the client
REACT_APP_CDN=http://localhost:4000/cdn
# The title of the client
REACT_APP_TITLE=Reactory
# The theme of the client
REACT_APP_THEME=reactory
# The client key
REACT_APP_CLIENT_KEY=reactory
# The shortname of the client
REACT_APP_SHORTNAME=Reactory
# The client password
REACT_APP_CLIENT_PASSWORD=bYGgEjp9U9BBi3R3RPx8DAjm+8thTKdpymngp2kU+50=
# The primary theme color
REACT_APP_THEME_PRIMARY=#1a2049
# The background theme color
REACT_APP_THEME_BG=#464775

# Feature Flags
ENABLE_DEBUG=true
ENABLE_OFFLINE_MODE=true

# Analytics (optional)
# ANALYTICS_KEY=your-analytics-key
